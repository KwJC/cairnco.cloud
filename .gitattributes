# Normalise to LF everywhere, in the repo AND in the working copy.
# Without this, Git on Windows rewrites these files to CRLF on the next
# checkout or clone. That would change every file's checksum and size for no
# real reason, and it breaks the read-back verification used when committing
# generated files from another machine.
* text=auto eol=lf

# Windows batch files are the exception. cmd.exe seeks by byte offset
# when it hits a goto or a call, and with LF-only endings it can land
# mid-line and fail to find a label. They must be CRLF in the working
# copy, or the buttons break in ways that look random.
*.bat text eol=crlf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
